# WebSocket Server Configuration
PORT=3000

# WordPress URL (for CORS)
WORDPRESS_URL=http://localhost:8000

# IMPORTANT: JWT Secret for token verification (REQUIRED - must match WordPress secret)
# This is used to cryptographically verify JWT tokens
# Must be the same as bcwp_websocket_secret in WordPress settings
JWT_SECRET=your-strong-secret-key-here-change-in-production

# Secret key for WordPress to trigger events (same as JWT_SECRET)
WEBSOCKET_SECRET=your-strong-secret-key-here-change-in-production
